# Configuration PayPal (serveur Node / server.js) — NE PAS committer de vraies valeurs
# Copier en .env ou définir dans l'environnement de l'hébergeur

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Sandbox (test) : https://api-m.sandbox.paypal.com
# Production       : https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Port HTTP du serveur (défaut: 3000)
PORT=3000
